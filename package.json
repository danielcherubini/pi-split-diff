{
	"name": "@heyhuynhgiabuu/pi-diff",
	"version": "0.3.0",
	"description": "Shiki-powered terminal diff renderer for pi — syntax-highlighted split and unified views with auto width detection.",
	"author": "huynhgiabuu",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/buddingnewinsights/pi-diff.git"
	},
	"homepage": "https://github.com/buddingnewinsights/pi-diff#readme",
	"bugs": {
		"url": "https://github.com/buddingnewinsights/pi-diff/issues"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"diff",
		"syntax-highlighting",
		"shiki",
		"terminal"
	],
	"files": [
		"dist/index.d.ts",
		"dist/index.d.ts.map",
		"dist/index.js",
		"dist/index.js.map",
		"dist/core/diff.d.ts",
		"dist/core/diff.d.ts.map",
		"dist/core/diff.js",
		"dist/core/diff.js.map",
		"media/",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"@shikijs/cli": "^4.0.2",
		"diff": "^7.0.0"
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*",
		"@mariozechner/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.5",
		"@types/diff": "^7.0.2",
		"@types/node": "^20.0.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"lint:fix": "biome check --fix src/",
		"test": "vitest run src --passWithNoTests",
		"test:watch": "vitest src --passWithNoTests"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	}
}
